#
# The pinned set e2e tests (vauchi/private#1032, decision D5): one Core
# tag and the commit of every component e2e builds from source. A green
# run proves exactly these; moving one is an MR that changes its line, so
# a red run names the component that moved. The relays and the CLI ship
# from main and have no current release tags, so commits are the pins.
#
# CORE_TAG is the tag e2e's own Cargo.toml pins, and the relay and the
# CLI at their commits must pin the same tag (ci/check-core-pin.sh), so
# the whole set runs one Core. The nightly heads lane (test:heads) runs
# every component at its main instead, to find drift between the mains.
CORE_TAG=v0.102.0
RELAY_SHA=e25ec95f67578423ed2fbefe93a1161c4e2c6115
OHTTP_RELAY_SHA=376a9835a86d00ce70a0d2fa7c4efd608fd5ee78
CLI_SHA=d56a6d9d4141caec180b207ec042e71178ece687
# The CLI of the newest store release, which the interop tests run against
# the current one (vauchi/private#1111). The support window starts at the
# first store release (maintainer, 2026-11-08); until then it is none and
# the interop tests run the current CLI on both sides. Moved by hand at a
# store release, never by the pins bot; ci/check-previous-core-pin.sh keeps
# it within the window of CORE_TAG.
PREVIOUS_CLI_SHA=none
